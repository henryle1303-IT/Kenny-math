# SQLite for local use. For Vercel/Neon see .env.postgres.example and README.
# Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Initial administrator (used only by `npm run db:seed` when no admin exists).
ADMIN_EMAIL="admin@example.com"
# Local only: if empty, seed prints a random password once.
# First production seed requires ADMIN_EMAIL and ADMIN_PASSWORD (12+ characters).
ADMIN_PASSWORD=""
# Set to "true" only when serving over plain HTTP outside localhost.
INSECURE_COOKIES="false"
