# SQLite for local use. Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Initial administrator (used only by `npm run db:seed` when no admin exists).
ADMIN_EMAIL="admin@example.com"
# If left empty a random password is generated and printed once by the seed script.
ADMIN_PASSWORD=""
# Set to "true" only when serving over plain HTTP outside localhost.
INSECURE_COOKIES="false"
