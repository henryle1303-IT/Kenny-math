{
  "name": "kenny-math-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Grade 5 mathematics learning platform with tests, Smart Review and admin question-bank management",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:vercel": "tsx scripts/postgres.ts build",
    "dev:postgres": "tsx scripts/postgres.ts dev",
    "db:setup:postgres": "tsx scripts/postgres.ts setup",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/serve-demo.mjs",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:deploy": "vitest run tests/deployment",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:postgres": "playwright test --config playwright.postgres.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "bank:au": "tsx scripts/build-au-bank.ts",
    "bank:export": "tsx scripts/export-bank-csv.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:seed:postgres": "tsx scripts/postgres.ts demo",
    "xp:backfill": "tsx scripts/xp-backfill.ts",
    "qa:report": "tsx scripts/qa-report.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
