# Copy to .env.local for an explicit local PostgreSQL session; never commit real URLs.
# On Vercel add these in Project Settings > Environment Variables instead.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&connection_limit=3&pool_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
INSECURE_COOKIES="false"
